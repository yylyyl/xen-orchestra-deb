#!/bin/sh
set -e

# Enable and start the service after installation
if [ "$1" = "configure" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        if [ -n "$2" ]; then
            action=restart
        else
            action=start
        fi
        deb-systemd-invoke $action xo-server.service || true
    fi
fi

exit 0

